---
/** Booking page: Google Calendar appointment schedule, linked from the shared footer. */
import Eyebrow from '../../components/Eyebrow.astro';
import Base from '../../layouts/Base.astro';

const SCHEDULE =
	'https://calendar.google.com/calendar/appointments/schedules/AcZssZ1ngCegO7DyFQyKuyy4U65Am2yN059bV4uvQbLz3cY1i5zP_G5S8mcOgF69ZAd369JbGFAUKfKY';
---

<Base title="Book a meeting" description="Book time with Subash Canapathy.">
	<div class="container page">
		<Eyebrow>Connect</Eyebrow>
		<h1 class="page-title">Book a meeting</h1>
		<p class="lede">Pick a time that works for you. You'll get a calendar invite with the details once it's booked.</p>
	</div>
	<div class="container booking">
		<!-- Google Calendar Appointment Scheduling begin -->
		<iframe
			src={`${SCHEDULE}?gv=true`}
			title="Book a time with Subash Canapathy (Google Calendar)"
			width="100%"
			height="600"
			loading="lazy"
			style="border: 0"></iframe>
		<!-- end Google Calendar Appointment Scheduling -->
		<p class="fallback">
			Calendar not loading? <a href={SCHEDULE} target="_blank" rel="noopener">Open it in Google Calendar</a>.
		</p>
	</div>
</Base>

<style>
	.page {
		padding-block: 72px 28px;
		display: flex;
		flex-direction: column;
		gap: 18px;
	}
	.booking {
		padding-bottom: 96px;
	}
	/* Google's page is always light, so it sits on a white card with a row-line frame in both themes. */
	iframe {
		display: block;
		width: 100%;
		height: 760px;
		background: #ffffff;
		border: 1px solid var(--line) !important;
		border-radius: var(--radius);
	}
	@media (max-width: 720px) {
		.page {
			padding-block: 48px 20px;
		}
		iframe {
			height: 900px;
		}
	}
	.fallback {
		margin-top: 14px;
		font-size: 14px;
		color: var(--muted);
	}
	.fallback a {
		color: var(--ink-2);
	}
</style>
