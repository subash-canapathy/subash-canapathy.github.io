---
/**
 * Profile (PLAN §14.3): masthead → Work highlights → How I work → Experience + sidebar.
 * Everything comes from src/content/profile/ (profile.yaml, companies.yaml, one folder per role)
 * and src/content/work/ (the three Work highlights, each with its own page).
 */
import { render } from 'astro:content';
import ArtifactCard from '../../components/ArtifactCard.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import LogoTile from '../../components/LogoTile.astro';
import Portrait from '../../components/Portrait.astro';
import Base from '../../layouts/Base.astro';
import { getArticles } from '../../lib/articles';
import { dateRange, duration, getCareer, monthYear } from '../../lib/profile';
import { url } from '../../lib/url';
import { getWork, workUrl } from '../../lib/work';

const { profile, groups, earlier, employerOf } = await getCareer();
const work = await getWork();
const articles = await getArticles();
const bodies = new Map(
	await Promise.all(groups.flatMap((g) => g.roles).map(async (r) => [r.id, (await render(r)).Content] as const)),
);
const HAT = { Coach: 'coach', Strategist: 'strategist', Builder: 'builder', Operator: 'operator' } as const;
const blocks = profile.working_style.flatMap((w) => Array.from({ length: w.percent / 5 }, () => HAT[w.hat]));
const resumeHref = url('/SubashCanapathy-Resume.pdf');
const earlierYears = earlier.length ? `${earlier.at(-1)!.data.start.slice(0, 4)} – ${earlier[0]!.data.end?.slice(0, 4) ?? 'now'}` : '';
const earlierEmployers = [...new Set(earlier.map((r) => employerOf(r).name))].join(', ');
---

<Base title="Profile" description={`${profile.name}, ${profile.title} at ${profile.employer}. ${profile.home_intro}`}>
	<div class="container profile">
		<section class="masthead" aria-labelledby="p-name">
			<div class="masthead__text">
				<div class="masthead__id">
					<h1 id="p-name">{profile.name}</h1>
					<p class="masthead__title">{profile.title}, {profile.employer}</p>
				</div>
				{profile.summary.map((para) => <p class="masthead__para">{para}</p>)}
				<p class="masthead__links">
					{
						profile.location && (
							<span>
								<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-6-5.3-6-11a6 6 0 0 1 12 0c0 5.7-6 11-6 11z" /><circle cx="12" cy="10" r="2.2" /></svg>
								{profile.location}
							</span>
						)
					}
					<a href={profile.links.linkedin}>
						<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M8 10.5V17M8 7.2v.1M12 17v-3.6a2.4 2.4 0 0 1 4.8 0V17M12 10.5V17" /></svg>
						LinkedIn
					</a>
					<a href={profile.links.github}>
						<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-4 1.3-4-2-6-2.5M15 21v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" /></svg>
						GitHub
					</a>
				</p>
			</div>
			<div class="masthead__side">
				<a class="resume" href={resumeHref} download aria-label="Download resume (PDF)">
					<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11" /><path d="M7 10l5 5 5-5" /><path d="M5 20h14" /></svg>
					<span class="resume__label">Resume</span>
					<span class="resume__pdf">PDF</span>
				</a>
				<Portrait size={184} phoneSize={0} class="masthead__portrait" />
			</div>
		</section>

		{
			work.items.length > 0 && (
				<section class="block" aria-labelledby="hl-h">
					<div class="hl">
						<div class="hl__lead">
							<span class="hl__icon">
								<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l9 5-9 5-9-5z" /><path d="M3 13l9 5 9-5" /></svg>
							</span>
							<h2 id="hl-h">{profile.highlights_intro?.title ?? 'Work highlights'}</h2>
							{profile.highlights_intro && <p>{profile.highlights_intro.text}</p>}
						</div>
						<div class="hl__grid">
							{work.items.map((w) => (
								<a class="hl__card" href={workUrl(w)}>
									<span class="hl__kicker">
										<LogoTile company={work.companyOf(w)} size={30} />
										<span>
											{work.employerOf(w).name} · {w.data.years}
										</span>
									</span>
									<span class="hl__title">{w.data.title}</span>
									<span class="hl__hook">{w.data.hook}</span>
									<span class="hl__more">Read the story →</span>
								</a>
							))}
						</div>
					</div>
				</section>
			)
		}

		{
			(profile.working_style.length > 0 || Object.keys(profile.competencies).length > 0) && (
				<section class="block" aria-labelledby="how-h">
					<h2 class="section-title" id="how-h">How I work</h2>
					<div class="how">
						{profile.working_style.length > 0 && (
							<div class="panel">
								<div>
									<h3>Working style</h3>
									<p class="panel__note">Each block is 5% of a typical week</p>
								</div>
								<div class="blocks" role="img" aria-label={`Share of a typical week: ${profile.working_style.map((w) => `${w.hat} ${w.percent}%`).join(', ')}`}>
									{blocks.map((hat) => <span class={`blk hat-${hat}`} />)}
								</div>
								<ul class="hats">
									{profile.working_style.map((w) => (
										<li>
											<span class="hats__name">
												<span class={`swatch swatch--sm hat-${HAT[w.hat]}`} />
												{w.hat}
												<span class="hats__pct">{w.percent}%</span>
											</span>
											<span class="hats__line">{w.line ?? w.covers}</span>
										</li>
									))}
								</ul>
							</div>
						)}
						{Object.keys(profile.competencies).length > 0 && (
							<div class="panel">
								<h3>Executive competencies</h3>
								{Object.entries(profile.competencies).map(([group, items]) => (
									<div class="comp">
										<Eyebrow>{group}</Eyebrow>
										<p class="comp__pills">
											{items.map((item) => <span class="comp__pill">{item}</span>)}
										</p>
									</div>
								))}
							</div>
						)}
					</div>
				</section>
			)
		}

		<div class="lower">
			<section class="experience" id="experience" aria-labelledby="xp-h">
				<div class="block__head">
					<h2 class="section-title" id="xp-h">Experience</h2>
					<button type="button" class="expand" data-expand-all aria-pressed="false">Expand all</button>
				</div>
				<div class="timeline">
					{
						groups.map((g) => (
							<div class="group">
								<div class="rail">
									<LogoTile company={g.company} />
									<span class="rail__line" aria-hidden="true" />
								</div>
								<div class="group__body">
									<div class="group__head">
										<h3>{g.company.name}</h3>
										<span class="muted">
											{dateRange(g.start, g.end)} · {duration(g.start, g.end)}
										</span>
									</div>
									{g.roles.map((r) => {
										const Body = bodies.get(r.id)!;
										const hasBody = (r.body ?? '').trim().length > 0;
										return (
											<details class="role" open={r.data.open} data-role>
												<summary>
													<span class="role__title">{r.data.title}</span>
													<span class="role__dates">
														{dateRange(r.data.start, r.data.end)}
														<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
													</span>
													<span class="role__scope">
														{r.data.scope}
														{r.data.location && ` · ${r.data.location}`}
													</span>
													<span class="role__outcome">{r.data.outcome}</span>
												</summary>
												<div class="role__more">
													{hasBody && (
														<>
															<Eyebrow>What I built</Eyebrow>
															<div class="role__built">
																<Body />
															</div>
														</>
													)}
													{r.data.scale && (
														<>
															<Eyebrow>Scale &amp; architecture</Eyebrow>
															<dl class="scale">
																{Object.entries(r.data.scale).map(([k, v]) => (
																	<>
																		<dt>{k}</dt>
																		<dd>{v}</dd>
																	</>
																))}
															</dl>
														</>
													)}
													{r.data.artifacts.length > 0 && (
														<>
															<Eyebrow>Artifacts</Eyebrow>
															<div class="artifacts">
																{r.data.artifacts.map((a) => (
																	<ArtifactCard artifact={a} articles={articles} />
																))}
															</div>
														</>
													)}
													{!hasBody && !r.data.scale && r.data.artifacts.length === 0 && <p class="muted">No further detail yet.</p>}
												</div>
											</details>
										);
									})}
								</div>
							</div>
						))
					}
					{
						earlier.length > 0 && (
							<div class="group">
								<div class="rail">
									<span class="rail__dot" aria-hidden="true" />
								</div>
								<div class="group__body group__body--last">
									<div class="group__head">
										<h3>Before {profile.earlier_roles_before}</h3>
										<span class="muted">{earlierEmployers}</span>
									</div>
									<details class="role" data-role>
										<summary class="earlier__summary">
											<span>
												Earlier roles <span class="muted">· {earlierYears}</span>
											</span>
											<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
										</summary>
										<ul class="earlier">
											{earlier.map((r) => (
												<li>
													<LogoTile company={employerOf(r)} size={40} />
													<span class="earlier__text">
														<strong>{r.data.title}</strong>
														<span>
															{r.data.scope}
															{r.data.location && ` · ${r.data.location}`}
														</span>
														<span>{r.data.outcome}</span>
													</span>
													<span class="earlier__dates">{dateRange(r.data.start, r.data.end)}</span>
												</li>
											))}
										</ul>
									</details>
								</div>
							</div>
						)
					}
				</div>
			</section>

			<aside class="sidebar">
				{
					profile.education.length > 0 && (
						<section class="side">
							<h2>Education</h2>
							{profile.education.map((e) => (
								<p class="side__item">
									<strong>{e.degree}</strong>
									<span>{e.school}</span>
									{e.years && <span class="muted small">{e.years}</span>}
								</p>
							))}
						</section>
					)
				}
				{
					profile.patents.length > 0 && (
						<section class="side">
							<h2>Patents</h2>
							<ul>
								{profile.patents.map((p) => {
									const meta = [p.company, p.number, p.date && monthYear(p.date)].filter(Boolean).join(' · ');
									return (
										<li>
											{p.url ? (
												<a href={p.url}>
													<strong>{p.title}</strong>
													<span class="muted small">{meta}</span>
												</a>
											) : (
												<span>
													<strong>{p.title}</strong>
													<span class="muted small">{meta}</span>
												</span>
											)}
										</li>
									);
								})}
							</ul>
						</section>
					)
				}
				{
					profile.languages.length > 0 && (
						<section class="side">
							<h2>Languages</h2>
							<ul>
								{profile.languages.map((l) => (
									<li class="side__row">
										<span>{l.name}</span>
										{l.level && <span class="muted">{l.level}</span>}
									</li>
								))}
							</ul>
						</section>
					)
				}
			</aside>
		</div>
	</div>
</Base>

<script>
	const button = document.querySelector<HTMLButtonElement>('[data-expand-all]');
	if (button) {
		const roles = () => [...document.querySelectorAll<HTMLDetailsElement>('details[data-role]')];
		button.addEventListener('click', () => {
			const expand = button.getAttribute('aria-pressed') !== 'true';
			roles().forEach((d) => (d.open = expand));
			button.setAttribute('aria-pressed', String(expand));
			button.textContent = expand ? 'Collapse all' : 'Expand all';
		});
	}
</script>

<style>
	.profile {
		padding-bottom: 56px;
	}
	.muted {
		color: var(--muted);
	}
	.small {
		font-size: 14px;
	}
	h3 {
		font-family: var(--font-serif-stack);
		font-weight: 500;
	}

	/* Masthead */
	.masthead {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 200px;
		gap: 56px;
		align-items: start;
		padding: 48px 0 32px;
	}
	.masthead__text {
		display: flex;
		flex-direction: column;
		gap: 14px;
		max-width: 740px;
	}
	.masthead__id {
		display: flex;
		flex-direction: column;
		gap: 8px;
		margin-bottom: 6px;
	}
	.masthead h1 {
		font-family: var(--font-serif-stack);
		font-weight: 500;
		font-size: 56px;
		line-height: 1.04;
		letter-spacing: -0.02em;
	}
	.masthead__title {
		font-size: 20px;
		font-weight: 500;
		line-height: 1.35;
	}
	.masthead__para {
		font-size: 17px;
		line-height: 1.65;
		color: var(--ink-2);
	}
	.masthead__links {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 22px;
		padding-top: 4px;
		font-size: 15px;
		color: var(--ink-2);
	}
	.masthead__links > * {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		min-height: 32px;
	}
	.masthead__links a:hover {
		color: var(--ink);
	}
	.masthead__side {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 72px;
		padding-top: 4px;
	}
	.resume {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: var(--control-h);
		padding: 0 18px 0 15px;
		border-radius: var(--radius-pill);
		background: var(--btn-bg);
		color: var(--btn-fg);
		font-size: 15px;
		font-weight: 500;
		transition: background-color var(--t-fast);
	}
	.resume:hover {
		background: var(--btn-bg-hover);
	}
	.resume__pdf {
		color: light-dark(#f2d872, #8c6a12);
	}

	/* Sections */
	.block {
		display: flex;
		flex-direction: column;
		gap: 22px;
		padding-bottom: 56px;
	}
	.block__head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px;
	}
	.jump {
		position: relative;
		font-size: 15px;
		line-height: 1.25;
		padding-bottom: 5px;
	}
	.jump span {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: var(--bar);
		border-radius: var(--radius-pill);
		background: var(--yellow);
	}

	/* Work highlights: intro on the left, three project cards on the right (stacked on phones). */
	.hl {
		display: grid;
		grid-template-columns: 240px minmax(0, 1fr);
		gap: 24px;
		align-items: start;
		padding: 26px;
		border: 1px solid var(--line);
		border-radius: 10px;
		background: var(--surface);
	}
	.hl__lead {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.hl__icon {
		width: 40px;
		height: 40px;
		display: flex;
		align-items: center;
		justify-content: center;
		border: 1px solid var(--line);
		border-radius: var(--radius-pill);
		background: var(--card);
	}
	.hl__lead h2 {
		font-family: var(--font-serif-stack);
		font-weight: 500;
		font-size: 24px;
		line-height: 1.2;
	}
	.hl__lead p {
		font-size: 15px;
		line-height: 1.6;
		color: var(--ink-2);
	}
	.hl__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 14px;
		min-width: 0;
	}
	.hl__card {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 18px;
		border: 1px solid var(--line);
		border-radius: 8px;
		background: var(--card);
		color: var(--ink);
		transition: border-color var(--t-fast);
	}
	.hl__card:hover {
		border-color: var(--line-control);
		text-decoration: none;
	}
	.hl__kicker {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: var(--fs-eyebrow);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.hl__title {
		font-family: var(--font-serif-stack);
		font-size: 21px;
		line-height: 1.25;
	}
	.hl__hook {
		font-size: 14px;
		line-height: 1.5;
		color: var(--ink-2);
	}
	.hl__more {
		margin-top: auto;
		padding-top: 4px;
		font-size: 14px;
		font-weight: 500;
	}
	.hl__card:hover .hl__more {
		text-decoration: underline;
		text-decoration-color: var(--yellow);
		text-decoration-thickness: var(--bar);
		text-underline-offset: 5px;
	}

	/* How I work */
	.how {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 22px;
	}
	.panel {
		display: flex;
		flex-direction: column;
		gap: 14px;
		min-width: 0;
		padding: 24px;
		border: 1px solid var(--line);
		border-radius: 10px;
		background: var(--surface);
	}
	.panel h3 {
		font-size: 22px;
	}
	.panel__note {
		margin-top: 4px;
		font-size: 14px;
		color: var(--muted);
	}
	.blocks {
		display: grid;
		grid-template-columns: repeat(10, minmax(0, 1fr));
		gap: 5px;
		padding: 4px 0 2px;
	}
	.blk {
		aspect-ratio: 1;
		border-radius: 5px;
		box-shadow: inset 0 0 0 1px rgba(26, 25, 23, 0.1);
	}
	.hat-coach {
		background: var(--hat-coach);
	}
	.hat-strategist {
		background: var(--hat-strategist);
	}
	.hat-builder {
		background: var(--hat-builder);
	}
	.hat-operator {
		background: var(--hat-operator);
	}
	.swatch {
		width: 11px;
		height: 11px;
		border-radius: 3px;
		box-shadow: inset 0 0 0 1px rgba(26, 25, 23, 0.1);
		flex-shrink: 0;
	}
	.swatch--sm {
		width: 9px;
		height: 9px;
	}
	.hats {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.hats li {
		display: grid;
		grid-template-columns: 140px minmax(0, 1fr);
		gap: 12px;
		align-items: baseline;
		padding: 9px 0;
		border-top: 1px solid var(--line);
	}
	.hats__name {
		display: inline-flex;
		align-items: baseline;
		gap: 8px;
		font-family: var(--font-serif-stack);
		font-size: 18px;
	}
	.hats__pct {
		font-family: var(--font-sans-stack, inherit);
		font-size: 14px;
		color: var(--muted);
	}
	.hats__line {
		font-size: 14px;
		line-height: 1.45;
		color: var(--ink-2);
	}
	.comp {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding-top: 14px;
		border-top: 1px solid var(--line);
	}
	.comp__pills {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.comp__pill {
		display: inline-flex;
		align-items: center;
		min-height: 34px;
		padding: 0 14px;
