---
/**
 * The resume, as a print page. Not linked and not indexed: after the site is built,
 * scripts/make-resume-pdf.mjs prints this page to /SubashCanapathy-Resume.pdf and removes it.
 * Same content files as the Profile page, in a tighter cut.
 *
 * Single column, set in Nunito: header with contact line, summary, competencies, experience,
 * then patents (two per row), then education and languages side by side. Roles may break across pages between
 * bullets, never inside one. See AUTHORING.md › "The resume PDF".
 */
import { Font } from 'astro:assets';
import { getCareer } from '../../../lib/profile';

const { profile, roles, companyOf, employerOf } = await getCareer();
const included = roles.filter((r) => r.data.resume.include);
const main = included.filter((r) => Number(r.data.start.slice(0, 4)) >= profile.earlier_roles_before);
const earlier = included.filter((r) => Number(r.data.start.slice(0, 4)) < profile.earlier_roles_before);

const short = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const realLinkedin = !/linkedin\.com\/?$/.test(profile.links.linkedin);
const year = (ym: string) => ym.slice(0, 4);
const span = (r: (typeof roles)[number]) => `${year(r.data.start)} – ${r.data.end ? year(r.data.end) : 'Present'}`;
// Contact-line glyphs (Tabler-style outlines, 24-unit grid).
const ICON = {
	pin: '<path d="M12 21s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12Z"/><circle cx="12" cy="9" r="2.5"/>',
	mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
	phone: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>',
	globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z"/>',
	linkedin: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M8 11v5M8 8v.01M12 16v-5M16 16v-3a2 2 0 0 0-4 0"/>',
} as const;
const icon = (name: keyof typeof ICON) =>
	`<svg class="ico" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${ICON[name]}</svg>`;
const linkedinShort = (u: string) => short(u).replace(/^linkedin\.com\//, '');
const place = (r: (typeof roles)[number]) =>
	companyOf(r).id !== employerOf(r).id ? `${employerOf(r).name} · ${companyOf(r).name}` : employerOf(r).name;

---

<!doctype html>
<html lang="en-CA" data-theme="light">
	<head>
		<meta charset="utf-8" />
		<meta name="robots" content="noindex" />
		<title>{profile.name} · Resume</title>
		<Font cssVariable="--font-resume-sans" />
	</head>
	<body>
		<header class="top">
			<h1>{profile.name}</h1>
			<p class="subtitle">{profile.title}, {profile.employer}</p>
			<ul class="contact">
				{profile.location && <li><Fragment set:html={icon('pin')} />{profile.location}</li>}
				{profile.contact.email && <li><Fragment set:html={icon('mail')} />{profile.contact.email}</li>}
				{profile.contact.phone && <li><Fragment set:html={icon('phone')} />{profile.contact.phone}</li>}
				<li><Fragment set:html={icon('globe')} />subash.org</li>
				{realLinkedin && <li><Fragment set:html={icon('linkedin')} />{linkedinShort(profile.links.linkedin)}</li>}
			</ul>
		</header>

		{
			profile.summary.length > 0 && (
				<section class="summary" aria-label="Summary">
					{profile.summary.map((p) => (
						<p>{p}</p>
					))}
				</section>
			)
		}

		{
			Object.keys(profile.competencies).length > 0 && (
				<section class="block">
					<h2>Competencies</h2>
					<dl class="skills">
						{Object.entries(profile.competencies).map(([group, items]) => (
							<>
								<dt>{group}</dt>
								<dd>{items.join(' · ')}</dd>
							</>
						))}
					</dl>
				</section>
			)
		}

		<section class="block">
			<h2>Experience</h2>
			{
				main.map((r) => (
					<article class="role">
						<div class="role__head">
							<div class="role__line">
								<h3>{r.data.title}</h3>
								<span class="dates">{span(r)}</span>
							</div>
							<p class="place">
								{place(r)}
								{r.data.location && <span class="muted"> · {r.data.location}</span>}
							</p>
							<p class="scope">{r.data.scope}</p>
						</div>
						<ul>
							<li>{r.data.outcome}</li>
							{(r.data.resume.bullets ?? []).map((b) => (
								<li>{b}</li>
							))}
						</ul>
					</article>
				))
			}
			{
				earlier.length > 0 && (
					<div class="earlier">
						<h4>Earlier</h4>
						{earlier.map((r) => (
							<div class="earlier__row">
								<p>
									<strong>{r.data.title}</strong>, {place(r)}
									<span class="muted"> · {r.data.outcome}</span>
								</p>
								<span class="dates">{span(r)}</span>
							</div>
						))}
					</div>
				)
			}
		</section>

		{
			profile.patents.length > 0 && (
				<section class="block">
					<h2>Patents</h2>
					<div class="patents">
						{profile.patents.map((p) => (
							<p class="item">
								<strong>{p.title}</strong>
								<br />
								<span class="muted">{[p.company, p.number, p.date && year(p.date)].filter(Boolean).join(' · ')}</span>
							</p>
						))}
					</div>
				</section>
			)
		}

		<section class="block foot">
			{
				profile.education.length > 0 && (
					<div>
						<h2>Education</h2>
						{profile.education.map((e) => (
							<p class="item">
								<strong>{e.degree}</strong>, {e.school}
								{e.years && <span class="muted"> · {e.years}</span>}
							</p>
						))}
					</div>
				)
			}
			{
				profile.languages.length > 0 && (
					<div>
						<h2>Languages</h2>
						<p class="item">
							{profile.languages.map((l, i) => (
								<>
									{i > 0 && <span class="sep">·</span>}
									{l.name}
									{l.level && <span class="muted"> ({l.level})</span>}
								</>
							))}
						</p>
					</div>
				)
			}
		</section>
	</body>
</html>

<style is:global>
	/* Letter, single column. Change size to A4 here if needed. */
	@page {
		size: Letter;
		margin: 0.55in 0.65in 0.55in;
	}
	:root {
		--ink: #2b2f36;
		--ink-strong: #111418;
		--muted: #6b7280;
		--accent: #8a6d1f;
		--rule: #e3e3e3;
		--sans: var(--font-resume-sans, 'Nunito'), 'Helvetica Neue', Arial, sans-serif;
	}
	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}
	html {
		-webkit-print-color-adjust: exact;
		print-color-adjust: exact;
	}
	body {
		max-width: 7.2in;
		margin: 0 auto;
		font-family: var(--sans);
		font-size: 9.4pt;
		line-height: 1.45;
		color: var(--ink);
		background: #fff;
		font-variant-numeric: lining-nums;
	}
	@media screen {
		body {
			padding: 0.55in 0;
		}
	}
	strong {
		font-weight: 700;
		color: var(--ink-strong);
	}
	.muted {
		color: var(--muted);
	}

	/* Header */
	.top {
		padding-bottom: 9pt;
		border-bottom: 1.5pt solid var(--ink-strong);
	}
	h1 {
		font-weight: 800;
		font-size: 24pt;
		line-height: 1.05;
		letter-spacing: -0.01em;
		color: var(--ink-strong);
	}
	.subtitle {
		margin-top: 3pt;
		font-weight: 600;
		font-size: 11pt;
		color: var(--accent);
	}
	.contact {
		display: flex;
		flex-wrap: wrap;
		gap: 2pt 9pt;
		margin-top: 5pt;
		list-style: none;
		font-size: 8.2pt;
		color: var(--muted);
	}
	.contact li {
		display: inline-flex;
		align-items: center;
		gap: 3.5pt;
	}
	.ico {
		width: 9pt;
		height: 9pt;
		flex: none;
		color: var(--accent);
	}

	.summary {
		margin-top: 10pt;
	}
	.summary p + p {
		margin-top: 5pt;
	}

	/* Sections */
	.block {
		margin-top: 13pt;
	}
	h2 {
		margin-bottom: 6pt;
		font-weight: 800;
		font-size: 8.4pt;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent);
		break-after: avoid;
	}

	.skills {
		display: grid;
		grid-template-columns: 0.95in 1fr;
		row-gap: 2pt;
	}
	.skills dt {
		font-weight: 700;
		color: var(--ink-strong);
	}

	/* Roles can break across pages between bullets; the heading always stays with the first bullets. */
	.role + .role {
		margin-top: 10pt;
		padding-top: 10pt;
		border-top: 1px solid var(--rule);
	}
	.role__head {
		break-inside: avoid;
		break-after: avoid;
	}
	.role__line {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 12pt;
	}
	h3 {
		font-weight: 800;
		font-size: 10.6pt;
		color: var(--ink-strong);
	}
	.dates {
		flex: none;
		font-weight: 600;
		font-size: 8.6pt;
		color: var(--muted);
	}
	.place {
		font-weight: 600;
	}
	.scope {
		margin-top: 1pt;
		font-style: italic;
		color: var(--muted);
	}
	.role ul {
		margin-top: 4pt;
		padding-left: 12pt;
	}
	.role li {
		break-inside: avoid;
		padding-left: 2pt;
	}
	.role li + li {
		margin-top: 2pt;
	}
	.role li::marker {
		color: var(--accent);
	}
	ul,
	p {
		orphans: 2;
		widows: 2;
	}

	.earlier {
		margin-top: 10pt;
		padding-top: 10pt;
		border-top: 1px solid var(--rule);
		break-inside: avoid;
	}
	h4 {
		margin-bottom: 3pt;
		font-weight: 700;
		font-size: 8.4pt;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.earlier__row {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 12pt;
	}
	.earlier__row + .earlier__row {
		margin-top: 2pt;
	}

	/* Four patents fit as two rows of two. */
	.patents {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 6pt 0.3in;
		break-inside: avoid;
	}
	.foot {
		display: grid;
		grid-template-columns: 1.6fr 1fr;
		gap: 0.3in;
		padding-top: 11pt;
		border-top: 1.5pt solid var(--ink-strong);
		break-inside: avoid;
	}
	.sep {
		margin: 0 5pt;
		color: var(--muted);
	}
	.foot .item + .item {
		margin-top: 5pt;
	}
</style>
