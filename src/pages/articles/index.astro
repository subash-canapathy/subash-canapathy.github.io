---
/** Articles index (PLAN §14.2). Skeleton for Phase 1; pinned card, tag pills and paging come in Phase 3. */
import Meta from '../../components/Meta.astro';
import Base from '../../layouts/Base.astro';
import { formatDate, getArticles, readingTime } from '../../lib/articles';

const articles = await getArticles();
---

<Base title="Articles" description="Essays on engineering leadership, AI transformation and agentic product development.">
	<div class="container page">
		<header class="page-head">
			<h1 class="page-title">Articles</h1>
			<p class="lede">Essays on engineering leadership, AI transformation and agentic product development.</p>
		</header>
		{
			articles.length === 0 ? (
				<p class="empty">The six Medium articles move here in Phase 3, with tag filters, the pinned article and paging.</p>
			) : (
				<ol class="list">
					{articles.map((a) => (
						<li class="list__row">
							<Meta items={[formatDate(a.data.date), readingTime(a)]} />
							<p class="list__title">{a.data.title}</p>
						</li>
					))}
				</ol>
			)
		}
	</div>
</Base>

<style>
	.page {
		padding-block: 48px 64px;
	}
	.page-head {
		display: flex;
		flex-direction: column;
		gap: 12px;
		margin-bottom: 32px;
	}
	.list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--line-section);
	}
	.list__row {
		display: grid;
		grid-template-columns: 200px minmax(0, 1fr);
		gap: 24px;
		padding-block: 20px;
		border-bottom: 1px solid var(--line);
	}
	.list__title {
		font-family: var(--font-serif-stack);
		font-weight: 500;
		font-size: 22px;
		line-height: 1.25;
	}
</style>
