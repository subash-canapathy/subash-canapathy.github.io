---
/** Album page: that album's photos, newest first, in the same grid and viewer. */
import BackLink from '../../components/BackLink.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import TextLink from '../../components/TextLink.astro';
import Base from '../../layouts/Base.astro';
import { type Album, getAlbums } from '../../lib/photos';
import { url } from '../../lib/url';

export async function getStaticPaths() {
	const albums = (await getAlbums()).filter((a) => a.photos.length > 0);
	return albums.map((album, i) => ({
		params: { album: album.id },
		props: { album, next: albums.length > 1 ? albums[(i + 1) % albums.length] : undefined },
	}));
}
const { album, next } = Astro.props as { album: Album; next?: Album };
---

<Base title={`${album.title} · Photography`} description={`${album.title}: photographs by Subash Canapathy.`}>
	<div class="container head">
		<BackLink href={url('/photography/')}>Photography</BackLink>
		<Eyebrow>Album</Eyebrow>
		<h1 class="page-title">{album.title}</h1>
	</div>
	<div class="container container--photos">
		<PhotoGrid photos={album.photos} layout={album.layout} />
	</div>
	<div class="container end">
		<p>End of album</p>
		{next && <TextLink href={url(`/photography/${next.id}/`)}>Next album: {next.title}</TextLink>}
	</div>
</Base>

<style>
	.head {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding-block: 32px 28px;
	}
	.end {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px;
		padding-block: 32px 64px;
		font-size: 14px;
		color: var(--muted);
	}
	@media (max-width: 720px) {
		.head {
			padding-block: 20px 20px;
		}
	}
</style>
