---
/**
 * Article page (PLAN §14.2). The Markdown body renders into `.prose`; everything above and
 * below it (tags, dates, attribution, hero, contents, related) comes from the front matter.
 */
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BackLink from '../../components/BackLink.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Portrait from '../../components/Portrait.astro';
import Base from '../../layouts/Base.astro';
import { type Article, articleUrl, cardImage, formatDate, getAllArticles, getArticles, primaryTag, readingTime, related, tagUrl } from '../../lib/articles';
import { getProfile } from '../../lib/profile';
import { url } from '../../lib/url';
import '../../styles/prose.css';

export async function getStaticPaths() {
	const all = await getAllArticles();
	return all.map((article) => ({ params: { slug: article.id }, props: { article } }));
}
const { article } = Astro.props as { article: Article };
const { Content, headings } = await render(article);
const sections = headings.filter((h) => h.depth === 2);
const profile = await getProfile();
const all = await getArticles();
const more = related(article, all, 2);

const { title, description, date, hero, hero_alt, original, tags, draft } = article.data;
const canonical = new URL(articleUrl(article), Astro.site).href;
const shareImage = cardImage(article);
const og = shareImage ? (await getImage({ src: shareImage, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src : undefined;
const thumbs = await Promise.all(
	more.map(async (a) => {
		const img = cardImage(a);
		return img ? (await getImage({ src: img, width: 336, height: 189, fit: 'cover' })).src : undefined;
	}),
);
---

<Base title={title} description={description} image={og} type="article" noindex={article.data.unlisted}>
	<div class="container article">
		{draft && <p class="draft-note">Draft: visible in local preview only. Set <code>draft: false</code> to publish.</p>}
		<header class="head">
			<BackLink href={url('/articles/')}>All articles</BackLink>
			<Eyebrow>{primaryTag(article)}</Eyebrow>
			<h1 class="title">{title}</h1>
			{
				original && (
					<p class="origin">
						Originally published in <a href={original.url}>{original.publication}</a>.
					</p>
				)
			}
			<div class="byline">
				<div class="author">
					<a href={url('/profile/')} aria-hidden="true" tabindex="-1">
						<Portrait size={40} />
					</a>
					<div class="author__text">
						<a class="author__name" href={url('/profile/')}>{profile.name}</a>
						<span class="author__meta">
							<time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time> · {readingTime(article)}
						</span>
					</div>
				</div>
				<div class="actions">
					<button type="button" class="icon-btn" aria-label="Copy link to this article" data-copy-link={canonical}>
						<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1" /><path d="M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1" /></svg>
					</button>
					<a class="icon-btn" aria-label="Share on LinkedIn" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonical)}`} target="_blank" rel="noopener">
						<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M8 10.5V17M8 7.2v.1M12 17v-3.6a2.4 2.4 0 0 1 4.8 0V17M12 10.5V17" /></svg>
					</a>
				</div>
			</div>
			{
				sections.length > 1 && (
					<details class="contents">
						<summary>
							<span>
								Contents <span class="contents__count">· {sections.length} sections</span>
							</span>
							<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
						</summary>
						<ol>
							{sections.map((h) => (
								<li>
									<a href={`#${h.slug}`}>{h.text}</a>
								</li>
							))}
						</ol>
					</details>
				)
			}
		</header>

		{
			hero && (
				<figure class="hero">
					<Image src={hero} alt={hero_alt ?? ''} widths={[640, 896, 1792]} sizes="(max-width: 976px) 100vw, 896px" loading="eager" />
				</figure>
			)
		}

		<article class="prose" data-prose>
			<Content />
		</article>

		<p class="filed">
			Filed under{' '}
			{tags.map((t, i) => (
				<>
					{i > 0 && ' · '}
					{article.data.unlisted ? t : <a href={tagUrl(t)}>{t}</a>}
				</>
			))}
		</p>

		{
			more.length > 0 && (
				<section class="keep" aria-labelledby="keep-h">
					<h2 id="keep-h">Keep reading</h2>
					<div class="keep__grid">
						{more.map((a, i) => (
							<a class="keep__card" href={articleUrl(a)}>
								{thumbs[i] && <img class="keep__thumb" src={thumbs[i]} alt="" width="168" height="94.5" loading="lazy" />}
								<div class="keep__text">
									<Eyebrow>{primaryTag(a)}</Eyebrow>
									<p class="keep__title">{a.data.title}</p>
									<p class="keep__meta">
										{formatDate(a.data.date)} · {readingTime(a)}
									</p>
								</div>
							</a>
						))}
					</div>
				</section>
			)
		}
	</div>
</Base>

<script>
	// Progressive touches on the rendered Markdown. The article reads fine without them.
	const prose = document.querySelector<HTMLElement>('[data-prose]');
	if (prose) {
		// Images: a Markdown title becomes the caption; "{wide}" at its end widens the figure.
		prose.querySelectorAll<HTMLImageElement>('img').forEach((img) => {
			const holder = img.parentElement;
			if (!holder || holder.closest('figure')) return;
			const figure = document.createElement('figure');
			let caption = img.getAttribute('title') ?? '';
			if (/\{wide\}\s*$/.test(caption)) {
				figure.classList.add('wide');
				caption = caption.replace(/\s*\{wide\}\s*$/, '');
			}
			img.removeAttribute('title');
			const alone = holder.tagName === 'P' && holder.childNodes.length === 1;
			(alone ? holder : img).replaceWith(figure);
			figure.append(img);
			if (caption) {
				const fc = document.createElement('figcaption');
				fc.textContent = caption;
				figure.append(fc);
			}
		});

		// Tables scroll sideways on narrow screens instead of breaking the layout.
		prose.querySelectorAll('table').forEach((table) => {
			const wrap = document.createElement('div');
			wrap.className = 'table-wrap';
			table.replaceWith(wrap);
			wrap.append(table);
		});

		// Code blocks: a bar with the language and a Copy button.
		prose.querySelectorAll<HTMLPreElement>('pre').forEach((pre) => {
			const box = document.createElement('div');
			box.className = 'code';
			const bar = document.createElement('div');
			bar.className = 'code__bar';
			const label = document.createElement('span');
			const lang = pre.dataset.language ?? '';
			label.textContent = lang && lang !== 'plaintext' ? lang : 'text';
			const copy = document.createElement('button');
			copy.type = 'button';
			copy.className = 'code__copy';
			copy.textContent = 'Copy';
			copy.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(pre.innerText);
					copy.textContent = 'Copied';
				} catch {
					copy.textContent = 'Press Ctrl+C';
				}
				setTimeout(() => (copy.textContent = 'Copy'), 1600);
			});
			bar.append(label, copy);
			pre.replaceWith(box);
			box.append(bar, pre);
		});
	}

	document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((button) => {
		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(button.dataset.copyLink ?? location.href);
				button.dataset.copied = 'true';
				button.setAttribute('aria-label', 'Link copied');
				setTimeout(() => {
					delete button.dataset.copied;
					button.setAttribute('aria-label', 'Copy link to this article');
				}, 1600);
			} catch {
				/* clipboard unavailable */
			}
		});
	});
</script>

<style>
	.article {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding-block: 28px 64px;
	}
	.head {
		width: 100%;
		max-width: var(--w-reading);
		display: flex;
		flex-direction: column;
		gap: 12px;
		margin-bottom: 24px;
	}
	.title {
		font-family: var(--font-serif-stack);
		font-weight: 500;
		font-size: 50px;
		line-height: 1.1;
		letter-spacing: -0.02em;
	}
	.origin {
		font-size: 14px;
		color: var(--muted);
	}
	.origin a {
		color: var(--ink-2);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.byline {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding-top: 6px;
	}
	.author {
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.author__text {
		display: flex;
		flex-direction: column;
		line-height: 1.35;
	}
	.author__name {
		font-size: 15px;
		font-weight: 500;
	}
	.author__meta {
		font-size: 14px;
		color: var(--muted);
	}
	.actions {
		display: flex;
		gap: 8px;
	}
	.icon-btn {
		width: var(--control-h);
		height: var(--control-h);
		display: flex;
		align-items: center;
		justify-content: center;
		background: transparent;
		border: 1px solid var(--line);
		border-radius: var(--radius-pill);
		color: var(--ink-2);
		cursor: pointer;
		transition:
			background-color var(--t-fast),
			border-color var(--t-fast);
	}
	.icon-btn:hover {
		background: var(--surface);
		border-color: var(--line-control);
	}
	.icon-btn[data-copied] {
		background: var(--yellow);
		border-color: var(--yellow);
		color: var(--on-yellow);
	}
	.contents {
		margin-top: 6px;
		border-block: 1px solid var(--line);
	}
	.contents summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 48px;
		cursor: pointer;
		list-style: none;
		font-size: 15px;
	}
	.contents summary::-webkit-details-marker {
		display: none;
	}
	.contents[open] summary svg {
		transform: rotate(180deg);
	}
	.contents__count {
		color: var(--muted);
	}
	.contents ol {
		margin: 0;
		padding: 0 0 14px 20px;
		font-size: 15px;
		line-height: 1.5;
	}
	.contents ol a {
		display: inline-block;
		padding: 5px 0;
		color: var(--ink-2);
	}
	.contents ol a:hover {
		color: var(--ink);
	}
	.hero {
		width: min(var(--w-figure-wide), 100%);
		margin: 8px 0 36px;
	}
	.hero :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: #ffffff;
	}
	.filed {
		width: 100%;
		max-width: var(--w-reading);
		margin: 6px 0 28px;
		font-size: 14px;
		color: var(--muted);
	}
	.filed a {
		color: var(--ink-2);
	}
	.filed a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.keep {
		width: 100%;
		margin-top: 56px;
		padding-top: 28px;
		border-top: 1px solid var(--line-section);
	}
	.keep h2 {
		margin-bottom: 18px;
		font-family: var(--font-serif-stack);
		font-weight: 500;
		font-size: 30px;
	}
	.keep__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 20px;
	}
	.keep__card {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 14px;
		border: 1px solid var(--line);
		border-radius: 8px;
		background: var(--card);
		transition: border-color var(--t-fast);
	}
	.keep__card:hover {
		border-color: var(--line-control);
	}
	.keep__thumb {
		width: 168px;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: 4px;
		flex-shrink: 0;
	}
	.keep__text {
		display: flex;
		flex-direction: column;
		gap: 6px;
		min-width: 0;
	}
	.keep__title {
		font-family: var(--font-serif-stack);
		font-size: 20px;
		font-weight: 500;
		line-height: 1.25;
	}
	.keep__meta {
		font-size: 13px;
		color: var(--muted);
	}
	.draft-note {
		width: 100%;
		max-width: var(--w-reading);
		margin-bottom: 12px;
		padding: 10px 14px;
		border: 1px dashed var(--line-control);
		border-radius: var(--radius);
		font-size: 14px;
		color: var(--muted);
	}
	@media (max-width: 720px) {
		.article {
			padding-top: 16px;
		}
		.title {
			font-size: 34px;
		}
		.keep__grid {
			grid-template-columns: minmax(0, 1fr);
		}
		.keep__thumb {
			width: 112px;
		}
	}
</style>
